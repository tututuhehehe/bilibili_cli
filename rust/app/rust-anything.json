{
  "schema": "rust-anything/front-door@1",
  "name": "bilibili_cli",
  "commands": [
    "help",
    "search",
    "list",
    "info",
    "dl",
    "doctor",
    "login"
  ],
  "units": [
    {
      "name": "proto",
      "crate": "proto-rs",
      "path": "../proto",
      "commands": [
        "search",
        "doctor"
      ],
      "switch": "RUST_ANYTHING_UNIT_PROTO"
    },
    {
      "name": "sign",
      "crate": "sign-rs",
      "path": "../sign",
      "commands": [
        "list",
        "login"
      ],
      "switch": "RUST_ANYTHING_UNIT_SIGN"
    },
    {
      "name": "play",
      "crate": "play-rs",
      "path": "../play",
      "commands": [
        "info",
        "dl"
      ],
      "switch": "RUST_ANYTHING_UNIT_PLAY"
    },
    {
      "name": "parse",
      "crate": "parse-rs",
      "path": "../parse",
      "commands": [],
      "switch": "RUST_ANYTHING_UNIT_PARSE"
    }
  ]
}