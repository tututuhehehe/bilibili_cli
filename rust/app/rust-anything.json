{
  "schema": "rust-anything/front-door@1",
  "name": "bilibili_cli",
  "commands": [
    "help",
    "search",
    "list",
    "info",
    "dl"
  ],
  "units": [
    {
      "name": "proto",
      "crate": "proto-rs",
      "path": "../proto",
      "commands": [
        "search"
      ],
      "switch": "RUST_ANYTHING_UNIT_PROTO"
    },
    {
      "name": "sign",
      "crate": "sign-rs",
      "path": "../sign",
      "commands": [
        "list"
      ],
      "switch": "RUST_ANYTHING_UNIT_SIGN"
    },
    {
      "name": "play",
      "crate": "play-rs",
      "path": "../play",
      "commands": [
        "dl"
      ],
      "switch": "RUST_ANYTHING_UNIT_PLAY"
    }
  ]
}
